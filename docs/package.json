{
	"name": "chronos-date-docs",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter chronos-date build && pnpm changelog && pnpm gen && next build",
		"dev": "pnpm changelog && pnpm gen && next dev",
		"start": "next start",
		"changelog": "node scripts/update-changelog.mjs",
		"gen": "node scripts/generate-types.mjs",
		"typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
		"typegen": "next typegen",
		"postinstall": "fumadocs-mdx",
		"validate:links": "fumadocs-mdx && bun scripts/validate-links.ts",
		"fix": "biome check --write --diagnostic-level=error",
		"lint": "biome check --diagnostic-level=error",
		"format": "biome format --write --diagnostic-level=error"
	},
	"dependencies": {
		"@ai-sdk/react": "^3.0.207",
		"@monaco-editor/react": "^4.7.0",
		"@openrouter/ai-sdk-provider": "^2.9.1",
		"@radix-ui/react-accordion": "^1.2.13",
		"@radix-ui/react-collapsible": "^1.1.13",
		"@radix-ui/react-popover": "^1.1.16",
		"@radix-ui/react-presence": "^1.1.6",
		"@radix-ui/react-scroll-area": "^1.2.11",
		"@radix-ui/react-tabs": "^1.1.14",
		"ai": "^6.0.205",
		"chronos-date": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"flexsearch": "^0.8.212",
		"fumadocs-core": "16.10.3",
		"fumadocs-mdx": "15.0.12",
		"fumadocs-twoslash": "^3.2.0",
		"fumadocs-ui": "16.10.3",
		"hast-util-to-jsx-runtime": "^2.3.6",
		"lucide-react": "^1.18.0",
		"next": "16.2.9",
		"next-themes": "^0.4.6",
		"next-validate-link": "^1.6.6",
		"nhb-hooks": "^1.50.11",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hot-toast": "^2.6.0",
		"react-icons": "^5.6.0",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-rehype": "^11.1.2",
		"scroll-into-view-if-needed": "^3.1.0",
		"sucrase": "^3.35.1",
		"tailwind-merge": "^3.6.0",
		"toolbox-x": "2.2.5",
		"twoslash": "^0.3.8",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@tailwindcss/postcss": "^4.3.1",
		"@types/hast": "^3.0.4",
		"@types/mdx": "^2.0.14",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"bun": "^1.3.14",
		"csstype": "^3.2.3",
		"github-slugger": "^2.0.0",
		"postcss": "^8.5.15",
		"tailwindcss": "^4.3.1",
		"type-fest": "^5.7.0",
		"typescript": "^6.0.3"
	}
}
